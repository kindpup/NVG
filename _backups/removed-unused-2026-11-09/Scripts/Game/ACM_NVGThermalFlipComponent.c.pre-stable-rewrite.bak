 [ComponentEditorProps(category: "GameScripted/Gadgets", description: "PVS-15 first-person night-vision and thermal modes.")]
class ACM_NVGThermalFlipComponentClass : ScriptComponentClass
{
}

class ACM_NVGThermalFlipComponent : ScriptComponent
{
	[Attribute("ACM_ToggleNVG", UIWidgets.EditBox, "Action that toggles the NVG view on/off.")]
	protected string m_sPowerAction;

	[Attribute("ACM_ChangeSightMode", UIWidgets.EditBox, "Action that cycles standard NV, white-hot, and black-hot modes.")]
	protected string m_sModeAction;

	[Attribute("{A15F15D00C4A4458}UI/Materials/ACM_NVG_WhiteHot.emat", UIWidgets.EditBox, "Self-contained white-hot thermal effect material.")]
	protected string m_sWhiteHotMaterial;

	[Attribute("{A15F15D00C4A4459}UI/Materials/ACM_NVG_BlackHot.emat", UIWidgets.EditBox, "Self-contained black-hot thermal effect material.")]
	protected string m_sBlackHotMaterial;

	[Attribute("{8F4EA38DBA5C4D7B}UI/Materials/ACM_NVG_BlueWhite.emat", UIWidgets.EditBox, "Blue-white phosphor image-intensifier effect material.")]
	protected string m_sBlueWhiteMaterial;

	protected bool m_bNVGActive;
	protected int m_iMode;
	protected int m_iAppliedCamera = -1;
	protected BaseWorld m_World;

	void ACM_NVGThermalFlipComponent(IEntityComponentSource src, IEntity ent, IEntity parent)
	{
		SetEventMask(ent, EntityEvent.FRAME | EntityEvent.INIT);
	}

	override void EOnInit(IEntity owner)
	{
		m_World = owner.GetWorld();
		m_bNVGActive = false;
		m_iMode = 0;

		InputManager input = GetGame().GetInputManager();
		if (input)
		{
			input.AddActionListener(m_sPowerAction, EActionTrigger.DOWN, OnPowerAction);
			input.AddActionListener(m_sModeAction, EActionTrigger.DOWN, OnModeAction);
		}

	}

	void ~ACM_NVGThermalFlipComponent()
	{
		InputManager input = GetGame().GetInputManager();
		if (input)
		{
			input.RemoveActionListener(m_sPowerAction, EActionTrigger.DOWN, OnPowerAction);
			input.RemoveActionListener(m_sModeAction, EActionTrigger.DOWN, OnModeAction);
		}
		ClearThermalEffect();
	}

	protected bool IsLocalWearer(IEntity owner)
	{
		PlayerController controller = GetGame().GetPlayerController();
		if (!controller)
			return false;

		IEntity character = controller.GetControlledEntity();
		if (!character)
			return false;

		InventoryItemComponent ownerItem = InventoryItemComponent.Cast(owner.FindComponent(InventoryItemComponent));
		if (ownerItem)
		{
			SCR_InventoryStorageManagerComponent storageManager = SCR_InventoryStorageManagerComponent.Cast(character.FindComponent(SCR_InventoryStorageManagerComponent));
			if (storageManager)
			{
				SCR_CharacterInventoryStorageComponent characterStorage = storageManager.GetCharacterStorage();
				if (characterStorage)
				{
					InventoryItemComponent headgear = characterStorage.GetItemFromLoadoutSlot(new LoadoutHeadCoverArea());
					if (headgear == ownerItem)
						return true;
				}
			}
		}

		IEntity current = owner;
		while (current)
		{
			if (current == character)
				return true;
			current = current.GetParent();
		}
		return false;
	}

	protected bool IsFirstPerson(IEntity character)
	{
		CameraHandlerComponent cameraHandler = CameraHandlerComponent.Cast(character.FindComponent(CameraHandlerComponent));
		if (!cameraHandler)
			return false;

		return !cameraHandler.IsInThirdPerson();
	}

	protected void OnPowerAction()
	{
		IEntity owner = GetOwner();
		if (!owner || !IsLocalWearer(owner))
			return;
		Print("[ACM NVG] Power action received by local wearer's PVS-15.");
		m_bNVGActive = !m_bNVGActive;
		if (!m_bNVGActive)
			ClearThermalEffect();
		else
			ApplyCurrentMode();
	}

	protected void OnModeAction()
	{
		IEntity owner = GetOwner();
		if (!owner || !m_bNVGActive || !IsLocalWearer(owner))
			return;
		Print("[ACM NVG] Mode cycle action received.");
		m_iMode = (m_iMode + 1) % 3;
		ApplyCurrentMode();
	}

	protected void ApplyCurrentMode()
	{
		if (!m_World || !m_bNVGActive)
			return;
		PlayerController controller = GetGame().GetPlayerController();
		if (!controller)
			return;
		IEntity character = controller.GetControlledEntity();
		if (!character || !IsFirstPerson(character))
		{
			ClearThermalEffect();
			return;
		}

		int cameraId = m_World.GetCurrentCameraId();
		m_iAppliedCamera = cameraId;
		if (m_iMode == 0)
		{
			// Blue-white phosphor image intensifier. Keep the exposure lift modest;
			// the Colors pass provides the monochrome phosphor tint.
			m_World.SetCameraPostProcessEffect(cameraId, 11, PostProcessEffectType.ThermalImaging, string.Empty);
			m_World.SetCameraPostProcessEffect(cameraId, 11, PostProcessEffectType.Colors, m_sBlueWhiteMaterial);
			m_World.AdjustCameraEV(cameraId, 0.15);
			return;
		}
		m_World.AdjustCameraEV(cameraId, 0.0);
		m_World.SetCameraPostProcessEffect(cameraId, 11, PostProcessEffectType.Colors, string.Empty);

		string material = m_sWhiteHotMaterial;
		if (m_iMode == 2)
			material = m_sBlackHotMaterial;

		// Apply the thermal image to the active player view, matching the reference
		// video. No separate PIP camera or render-target material is needed.
		m_World.SetCameraPostProcessEffect(cameraId, 11, PostProcessEffectType.ThermalImaging, material);
	}

	protected void ClearThermalEffect()
	{
		if (!m_World)
			return;

		int cameraId = m_iAppliedCamera;
		if (cameraId < 0)
			cameraId = m_World.GetCurrentCameraId();
		m_World.SetCameraPostProcessEffect(cameraId, 11, PostProcessEffectType.ThermalImaging, string.Empty);
		m_World.SetCameraPostProcessEffect(cameraId, 11, PostProcessEffectType.Colors, string.Empty);
		m_World.AdjustCameraEV(cameraId, 0.0);
	}

	override void EOnFrame(IEntity owner, float timeSlice)
	{
		if (!m_bNVGActive)
			return;
		ApplyCurrentMode();
	}
}
